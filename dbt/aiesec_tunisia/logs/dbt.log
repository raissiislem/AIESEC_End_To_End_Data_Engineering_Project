  create  table "aiesec_dw"."gold"."dim_date__dbt_tmp"
  
  
    as
  
  (
    with calendar as (
    select
        generate_series(
            date '2023-01-01',
            date '2026-12-01',
            interval '1 month'
        )::date as date
)

select
    row_number() over (order by date) as date_key,
    date,
    extract(year from date)    as year,
    extract(month from date)   as month,
    extract(quarter from date) as quarter
from calendar
  );
  
