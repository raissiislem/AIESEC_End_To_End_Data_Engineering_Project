  create  table "aiesec_dw"."silver_gold"."dim_date__dbt_tmp"
  
  
    as
  
  (
    with distinct_dates as (
    select distinct to_date(period_start, 'MM/DD/YYYY') as date
    from "aiesec_dw"."silver"."performance"
)

